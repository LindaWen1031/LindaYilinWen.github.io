---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout title="About" description={site.about[0]}>
  <section class="section about">
    <div class="wrap">
      <p class="eyebrow">About</p>
      <h1 class="about__title">{site.name}</h1>
      <p class="about__role">{site.role}, {site.org}</p>

      <div class="about__body">
        {site.about.map((p) => <p set:html={p} />)}
      </div>

      {
        site.focus.length > 0 && (
          <section class="focus" data-reveal>
            <p class="eyebrow">What I focus on</p>
            <ul>
              {site.focus.map((f) => (
                <li>{f}</li>
              ))}
            </ul>
          </section>
        )
      }

      {
        site.publications.length > 0 && (
          <section class="listing" data-reveal>
            <p class="eyebrow">Publications</p>
            <ul>
              {site.publications.map((p) => (
                <li class="listing__item">
                  <p class="listing__title">
                    {p.url ? (
                      <a href={p.url} target="_blank" rel="noopener">
                        {p.title}
                      </a>
                    ) : (
                      p.title
                    )}
                  </p>
                  {p.authors && <p class="listing__meta">{p.authors}</p>}
                  <p class="listing__meta">
                    {[p.venue, p.year].filter(Boolean).join(' · ')}
                  </p>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        site.press.length > 0 && (
          <section class="listing" data-reveal>
            <p class="eyebrow">News &amp; press</p>
            <ul>
              {site.press.map((n) => (
                <li class="listing__item">
                  <p class="listing__title">
                    {n.url ? (
                      <a href={n.url} target="_blank" rel="noopener">
                        {n.title}
                      </a>
                    ) : (
                      n.title
                    )}
                  </p>
                  <p class="listing__meta">
                    {[n.outlet, n.date].filter(Boolean).join(' · ')}
                  </p>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        site.talks.length > 0 && (
          <section class="listing" data-reveal>
            <p class="eyebrow">Invited talks &amp; lectures</p>
            <ul>
              {site.talks.map((t) => (
                <li class="listing__item">
                  <p class="listing__title">{t.venue}</p>
                  {[t.title, t.date].filter(Boolean).length > 0 && (
                    <p class="listing__meta">
                      {[t.title, t.date].filter(Boolean).join(' · ')}
                    </p>
                  )}
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .about {
    padding-block: var(--s-6) var(--s-7);
  }

  .about__title {
    font-size: var(--step-3);
    margin-block-start: var(--s-2);
  }

  .about__role {
    color: var(--ink-faint);
    margin-block-start: var(--s-1);
  }

  .about__body {
    max-width: var(--measure);
    margin-block-start: var(--s-5);
  }

  .about__body > * + * {
    margin-block-start: var(--s-3);
  }

  .about__body p {
    color: var(--ink-soft);
  }

  /* The About paragraphs are injected with `set:html`, so their anchors never
     receive Astro's scope attribute — they must be matched with :global(). */
  .about__body :global(a) {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
  }

  .about__body :global(a:hover) {
    color: var(--accent);
  }

  .about__body p:first-child {
    font-family: var(--font-reading);
    font-size: var(--step-2);
    line-height: 1.45;
    color: var(--ink);
  }

  .focus {
    margin-block-start: var(--s-6);
    padding-block-start: var(--s-3);
    border-top: 1px solid var(--rule);
    max-width: var(--measure);
  }

  .focus ul {
    list-style: none;
    padding: 0;
    margin: var(--s-3) 0 0;
  }

  .focus li {
    padding-block: var(--s-2);
    border-bottom: 1px solid var(--rule);
    font-size: var(--step-1);
    line-height: var(--leading-snug);
  }

  .listing {
    margin-block-start: var(--s-6);
    padding-block-start: var(--s-3);
    border-top: 1px solid var(--rule);
    max-width: var(--measure);
  }

  .listing ul {
    list-style: none;
    padding: 0;
    margin: var(--s-3) 0 0;
  }

  .listing__item {
    padding-block: var(--s-3);
    border-bottom: 1px solid var(--rule);
  }

  .listing__title {
    font-size: var(--step-0);
    line-height: var(--leading-snug);
    color: var(--ink);
  }

  .listing__title a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
  }

  .listing__meta {
    margin-block-start: var(--s-1);
    font-size: var(--step--1);
    color: var(--ink-faint);
  }
</style>
