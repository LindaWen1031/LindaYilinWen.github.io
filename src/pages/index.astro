---
import BaseLayout from '../layouts/BaseLayout.astro';
import GradientField from '../components/GradientField.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site } from '../data/site';
import { getFeaturedProjects } from '../lib/projects';
import { url } from '../lib/url';

const featured = await getFeaturedProjects();
---

<BaseLayout transparentNav>
  <section class="hero">
    <GradientField />
    <div class="wrap-wide hero__inner">
      <h1 class="hero__statement">{site.heroStatement}</h1>
      <a class="hero__cue" href="#work">Selected work</a>
    </div>
  </section>

  <section class="section intro">
    <div class="wrap">
      <div data-reveal>
        <p class="eyebrow">About</p>
        <p class="intro__text" set:html={site.heroSubline} />
        <p class="teaser__link"><a href={url('/about')}>More about me →</a></p>
      </div>
    </div>
  </section>

  <section id="work" class="section work">
    <div class="wrap-wide">
      <header class="work__head" data-reveal>
        <h2>Selected work</h2>
      </header>

      {
        featured.length > 0 ? (
          <div class="work__list">
            {featured.map((project, i) => (
              <ProjectCard project={project} feature={i === 0} index={i} />
            ))}
          </div>
        ) : (
          <p class="lede">
            No featured projects yet. Set <code>featured: true</code> in a
            project's frontmatter to show it here.
          </p>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: min(90svh, 52rem);
    /* Pull up under the sticky nav so the colour runs to the top of the page. */
    margin-block-start: calc(-1 * var(--nav-height));
    display: flex;
    /* Centred rather than bottom-anchored: with the hero a full viewport
       tall, anchoring to the bottom dumped all the slack above the
       headline, and that gap grew with the height of the window. The top
       padding clears the nav the hero sits under, so "centred" means
       centred in the space you can actually see. */
    align-items: center;
    padding-block: calc(var(--nav-height) + var(--s-4)) var(--s-5);
    overflow: hidden;
    color: var(--hero-ink);
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    max-width: var(--width-wide);
  }

  .hero__statement {
    /* Deliberately a step down from --step-4 (the h1 size used elsewhere).
       At 105 characters this is a sentence, not a three-word banner, so it
       reads better a little smaller and a little wider: four lines rather
       than five, and roughly a third of the hero instead of half. */
    max-width: 24ch;
    font-size: clamp(2.25rem, 1.5rem + 3.2vw, 4rem);
    color: var(--hero-ink);
    text-shadow: 0 1px 30px rgba(70, 32, 20, 0.28);
  }

  .hero__cue {
    margin-block-start: var(--s-4);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--hero-ink);
    width: fit-content;
    border-bottom: 1px solid var(--hero-ink-soft);
    padding-block-end: 0.35rem;
    opacity: 0.9;
  }

  .hero__cue:hover {
    color: var(--hero-ink);
    opacity: 1;
  }

  .work__head {
    max-width: 26ch;
    margin-block-end: var(--s-5);
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .work__head h2 {
    font-size: var(--step-3);
  }

  .work__list {
    border-bottom: 1px solid var(--rule);
  }

  .work__more {
    margin-block-start: var(--s-4);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .work__more a {
    text-decoration: none;
    color: var(--accent);
  }

  .intro {
    background: var(--paper-sunk);
    border-top: 1px solid var(--rule);
  }

  .intro__text {
    max-width: 62ch;
    font-family: var(--font-reading);
    font-size: var(--step-1);
    line-height: 1.62;
    margin-block-start: var(--s-3);
  }

  .intro__text :global(a) {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
  }

  .intro__text :global(a:hover) {
    color: var(--accent);
  }

  .teaser__link {
    margin-block-start: var(--s-4);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .teaser__link a {
    text-decoration: none;
    color: var(--accent);
  }
</style>
