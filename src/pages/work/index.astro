---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../lib/projects';

const projects = await getProjects();
---

<BaseLayout
  title="Work"
  description="Case studies in productizing frontier AI models, leading multidisciplinary research teams, and human-centered AI practice."
>
  <section class="head">
    <div class="wrap-wide">
      <p class="eyebrow">Work</p>
      <h1 class="head__title">Case studies</h1>
    </div>
  </section>

  <section class="wrap-wide list">
    {
      projects.length > 0 ? (
        <div id="project-list">
          {projects.map((project, i) => (
            <div class="list__item">
              <ProjectCard project={project} index={i} />
            </div>
          ))}
        </div>
      ) : (
        <p class="lede">
          Nothing published yet. Add a Markdown file to
          <code>src/content/projects/</code> to get started.
        </p>
      )
    }
  </section>
</BaseLayout>

<style>
  .head {
    padding-block: var(--s-6) var(--s-4);
  }

  .head__title {
    font-size: var(--step-3);
    margin-block-start: var(--s-2);
  }

  .head__lede {
    max-width: 48ch;
    margin-block-start: var(--s-3);
  }

  .list {
    padding-block-end: var(--s-7);
  }

  #project-list {
    border-bottom: 1px solid var(--rule);
  }

</style>
