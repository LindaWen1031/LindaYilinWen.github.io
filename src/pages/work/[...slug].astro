---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Prose from '../../components/Prose.astro';
import { getProjects, getNeighbours } from '../../lib/projects';
import { themeLabels } from '../../data/site';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const { prev, next } = await getNeighbours(project.id);
---

<BaseLayout
  title={data.title}
  description={data.summary}
  image={data.cover}
>
  <article>
    <header class="head">
      <div class="wrap">
        <p class="eyebrow">
          <a href={url('/work')}>Work</a> · {data.timeframe} · {data.org}
        </p>
        <h1 class="head__title">{data.title}</h1>
        <p class="lede head__summary">{data.summary}</p>

        <dl class="head__facts">
          <div>
            <dt>Role</dt>
            <dd>{data.role}</dd>
          </div>
          <div>
            <dt>Focus</dt>
            <dd>{data.focus ?? data.themes.map((t) => themeLabels[t] ?? t).join(', ')}</dd>
          </div>
        </dl>
      </div>
    </header>

    {
      data.cover && (
        <div class="wrap-wide">
          <img
            class="cover"
            src={url(data.cover)}
            alt={data.coverAlt ?? ''}
            loading="eager"
            decoding="async"
          />
        </div>
      )
    }

    {
      data.metrics && data.metrics.length > 0 && (
        <div class="wrap">
          <ul class="metrics" data-reveal>
            {data.metrics.map((m) => (
              <li>
                <span class="metrics__value">{m.value}</span>
                <span class="metrics__label">{m.label}</span>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <div class="wrap body">
      {data.notice && (
        <aside class="notice" role="note">
          <p>{data.notice}</p>
        </aside>
      )}

      <Prose>
        <Content />
      </Prose>

      {
        data.links && data.links.length > 0 && (
          <aside class="links">
            <p class="eyebrow">Further reading</p>
            <ul>
              {data.links.map((l) => (
                <li>
                  <a href={l.url} target="_blank" rel="noopener">
                    {l.label} ↗
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        )
      }
    </div>

    {
      (prev || next) && (
        <nav class="wrap-wide pager" aria-label="More projects">
          {prev ? (
            <a href={url(`/work/${prev.id}`)} class="pager__link">
              <span class="eyebrow">Previous</span>
              <span class="pager__title">{prev.data.title}</span>
            </a>
          ) : (
            <span />
          )}
          {next && (
            <a href={url(`/work/${next.id}`)} class="pager__link pager__link--next">
              <span class="eyebrow">Next</span>
              <span class="pager__title">{next.data.title}</span>
            </a>
          )}
        </nav>
      )
    }
  </article>
</BaseLayout>

<style>
  .head {
    padding-block: var(--s-6) var(--s-4);
  }

  .head__title {
    font-size: var(--step-3);
    margin-block-start: var(--s-2);
    max-width: 22ch;
  }

  .head__summary {
    margin-block-start: var(--s-3);
    max-width: 50ch;
  }

  .head__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
    margin-block-start: var(--s-4);
    padding-block-start: var(--s-3);
    border-top: 1px solid var(--rule);
  }

  .head__facts dt {
    font-size: var(--step--1);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .head__facts dd {
    margin: 0.2rem 0 0;
    color: var(--ink);
    max-width: 34ch;
  }

  .cover {
    width: 100%;
    aspect-ratio: 16 / 8;
    object-fit: cover;
    border-radius: var(--radius-lg);
    background: var(--paper-sunk);
    margin-block: var(--s-4);
  }

  .metrics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-5);
    list-style: none;
    padding: var(--s-4) 0;
    margin: var(--s-4) 0 0;
    border-block: 1px solid var(--rule);
  }

  .metrics li {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .metrics__value {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.1;
    letter-spacing: var(--tracking-tight);
    font-variation-settings: 'SOFT' 40, 'WONK' 1;
  }

  .metrics__label {
    font-size: var(--step--1);
    color: var(--ink-faint);
    max-width: 22ch;
  }

  .body {
    padding-block: var(--s-5) var(--s-7);
  }

  /* Standing note about the project itself — e.g. an older piece of work, or a
     product that has since been retired. Sits above the body, quieter than the
     prose so it reads as context rather than as the opening argument. */
  .notice {
    max-width: var(--measure);
    margin-block-end: var(--s-5);
    padding: var(--s-3);
    border-inline-start: 2px solid var(--accent-soft);
    background: var(--paper-sunk);
    border-radius: var(--radius);
  }

  .notice p {
    font-size: var(--step--1);
    color: var(--ink-soft);
    line-height: 1.6;
  }

  .links {
    margin-block-start: var(--s-6);
    padding-block-start: var(--s-3);
    border-top: 1px solid var(--rule);
    max-width: var(--measure);
  }

  .links ul {
    list-style: none;
    padding: 0;
    margin: var(--s-2) 0 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
  }

  .links a {
    color: var(--accent);
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: var(--s-4);
    padding-block: var(--s-5) var(--s-7);
    border-top: 1px solid var(--rule);
  }

  .pager__link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    text-decoration: none;
    max-width: 24ch;
  }

  .pager__link--next {
    text-align: right;
    margin-inline-start: auto;
  }

  .pager__title {
    font-family: var(--font-display);
    font-size: var(--step-1);
    letter-spacing: var(--tracking-tight);
    font-variation-settings: 'SOFT' 40, 'WONK' 1;
  }

  .pager__link:hover .pager__title {
    color: var(--accent);
  }
</style>
