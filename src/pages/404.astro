---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';
---

<BaseLayout title="Not found" description="That page does not exist.">
  <section class="section nf">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1>That page went missing.</h1>
      <p class="lede">
        The link may be old, or I may have moved something. Try the <a
          href={url('/work')}>work</a> page.
      </p>
      <p class="nf__home"><a href={url('/')}>← Back home</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    padding-block: var(--s-7);
  }

  .nf h1 {
    font-size: var(--step-3);
    margin-block: var(--s-2) var(--s-3);
  }

  .nf__home {
    margin-block-start: var(--s-4);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .nf__home a {
    text-decoration: none;
    color: var(--accent);
  }
</style>
