---
/**
 * Use inside a case study when you want an image to break out of the text
 * column.
 *
 * Plain `.md` files support standard Markdown images:
 *   ![Alt text](/media/my-project/photo.jpg)
 *
 * For a wide, captioned image, rename the file to `.mdx` and use:
 *
 *   import Figure from '../../components/Figure.astro';
 *
 *   <Figure src="/media/my-project/workshop.jpg"
 *           alt="Participants clustering sticky notes"
 *           caption="Synthesis session, day two."
 *           wide />
 */
import { url } from '../lib/url';

interface Props {
  src: string;
  alt: string;
  caption?: string;
  /** Break out past the prose column. */
  wide?: boolean;
  /** Center and cap the image well inside the prose column. */
  narrow?: boolean;
  /**
   * For strongly portrait images — phone screenshots especially. Caps the
   * image by *height* rather than width, so it can be taken in at a glance
   * instead of running past the bottom of the window.
   */
  tall?: boolean;
}

const {
  src,
  alt,
  caption,
  wide = false,
  narrow = false,
  tall = false,
} = Astro.props;
---

<figure
  class:list={[
    'figure',
    wide && 'figure--wide',
    narrow && 'figure--narrow',
    tall && 'figure--tall',
  ]}
>
  <img src={url(src)} alt={alt} loading="lazy" decoding="async" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure {
    margin-block: var(--s-5);
  }

  .figure img {
    width: 100%;
    border-radius: var(--radius-lg);
    background: var(--paper-sunk);
  }

  .figure figcaption {
    margin-block-start: var(--s-2);
    font-size: var(--step--1);
    color: var(--ink-faint);
    max-width: 60ch;
    margin-inline: auto;
    text-align: center;
  }

  .figure--narrow {
    max-width: min(100%, 24rem);
    margin-inline: auto;
  }

  /* Height-capped: the width follows from the aspect ratio, so a tall phone
     screenshot sits at roughly phone size instead of filling the column and
     running off the bottom of the window. */
  .figure--tall img {
    width: auto;
    max-width: 100%;
    max-block-size: min(72svh, 34rem);
    margin-inline: auto;
  }

  @media (min-width: 64rem) {
    .figure--wide {
      width: min(72rem, calc(100vw - 2 * var(--gutter)));
      margin-inline: calc(50% - min(36rem, (100vw - 2 * var(--gutter)) / 2));
    }
  }
</style>
