---
/**
 * GradientField — the smeared-paint backdrop on the landing page.
 *
 * Soft, elongated blobs of warm colour drift diagonally across a coral base,
 * blurring into one another. The pointer behaves like a hand moving through
 * water: it eases toward where the mouse actually is, softly pushes nearby
 * colour aside, and everything drifts back on a slow, heavily damped spring.
 * Nothing tracks the mouse directly, so quick movements barely register.
 *
 * How it stays fast: the blobs are painted into a tiny offscreen buffer (a few
 * hundred pixels across), then upscaled by the browser and blurred in CSS.
 * That means the per-frame work is trivial no matter how large the screen is.
 *
 * It is decorative: `aria-hidden`, sits behind real DOM text, and holds a
 * single still frame for anyone who prefers reduced motion.
 *
 * ── TUNING ──────────────────────────────────────────────────────────────────
 * Every dial lives in the CONFIG block at the top of the script below.
 * Colours come from the `--hero-*` custom properties in src/styles/tokens.css.
 */
---

<div class="field" aria-hidden="true">
  <canvas id="gradient-field"></canvas>
</div>

<style>
  .field {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--hero-base);
  }

  #gradient-field {
    /* Oversized and offset so the blur never reveals a soft edge. */
    position: absolute;
    top: -12%;
    left: -12%;
    width: 124%;
    height: 124%;
    display: block;
    filter: blur(12px) saturate(1.12);
    opacity: 0;
    transition: opacity 1400ms var(--ease);
  }

  #gradient-field[data-ready] {
    opacity: 1;
  }

  /* A soft vignette keeps the headline legible over the brightest smears. */
  .field::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(60, 30, 20, 0.14) 0%,
      rgba(60, 30, 20, 0) 32%,
      rgba(60, 30, 20, 0.2) 100%
    );
  }
</style>

<script>
  // ── CONFIG ────────────────────────────────────────────────────────────────
  // Safe to fiddle with. Nothing below this block needs to change.
  const CONFIG = {
    /** How many blobs of colour. More = busier. */
    blobCount: 24,
    /** Longest edge of the offscreen buffer, in pixels. Small is the point. */
    bufferSize: 340,
    /** Blob radius as a fraction of the buffer's short edge. Keep these small:
     *  thin strokes stretched a long way is what reads as a smear. */
    minRadius: 0.06,
    maxRadius: 0.15,
    /** Drift speed, in buffer pixels per frame. */
    driftSpeed: 0.14,
    /** Base stretch along the direction of travel. 1 = round, higher = smeared. */
    elongation: 2.6,
    /** Extra stretch picked up from motion. */
    elongationFromSpeed: 16,
    /** Hard ceiling on stretch, so nothing ever whips into a hard line. */
    maxElongation: 5,
    /** The diagonal every stroke travels along, in degrees. Keeping the spread
     *  narrow is what makes the field read as one deliberate gesture. */
    angleDegrees: -32,
    angleSpread: 70,
    /** Pointer influence radius, as a fraction of the buffer's short edge.
     *  Kept local: the point is a ripple around the cursor, not the whole
     *  field heaving every time the mouse moves. */
    cursorRadius: 0.4,
    /** How quickly the field's idea of "where the pointer is" catches up to the
     *  real one. Low numbers are the whole trick: the colour lags behind the
     *  mouse instead of snapping to it, so a fast flick barely registers. */
    pointerEase: 0.045,
    /** How hard the pointer pushes nearby colour away from itself, per frame,
     *  as a fraction of the buffer's short edge. Deliberately tiny — the spring
     *  below balances it out at a displacement of only a few percent. */
    cursorPush: 0.00035,
    /** How firmly displaced colour is pulled back to where it belongs. Low =
     *  a long, slow relaxation, like a pond settling. */
    springBack: 0.011,
    /** Damping on that return. High = no visible bounce, just a soft glide. */
    damping: 0.9,
    /** Ceiling on how far colour can be pushed, as a fraction of the buffer's
     *  short edge. Stops a lingering cursor from tearing the field apart. */
    maxDisplacement: 0.1,
    /** Opacity range for individual blobs. */
    opacityMin: 0.5,
    opacityMax: 1,
  };
  // ──────────────────────────────────────────────────────────────────────────

  const wrap = document.querySelector<HTMLElement>('.field');
  const canvas = document.getElementById(
    'gradient-field',
  ) as HTMLCanvasElement | null;

  if (wrap && canvas) {
    const ctx = canvas.getContext('2d', { alpha: false });

    if (ctx) {
      const reduced = window.matchMedia(
        '(prefers-reduced-motion: reduce)',
      ).matches;

      const styles = getComputedStyle(document.documentElement);
      const readColor = (name: string, fallback: string) =>
        styles.getPropertyValue(name).trim() || fallback;

      const base = readColor('--hero-base', '#c9765f');
      const baseLight = readColor('--hero-base-light', '#d98a6b');
      const baseDeep = readColor('--hero-base-deep', '#b2604f');
      const palette = [
        readColor('--hero-1', '#ffd2ab'),
        readColor('--hero-2', '#f6b087'),
        readColor('--hero-3', '#e3d6a6'),
        readColor('--hero-4', '#b25c58'),
      ];
      // Weighted so the bright peaches dominate and sand stays occasional.
      const weights = [0.4, 0.3, 0.12, 0.18];

      type Blob = {
        /** Where the blob belongs; drifts steadily and ignores the pointer. */
        x: number;
        y: number;
        /** Its own gentle drift. Constant. */
        vx: number;
        vy: number;
        /** How far it is currently pushed away from home, and how fast that
         *  displacement is changing. This is the only thing the pointer moves. */
        ox: number;
        oy: number;
        ovx: number;
        ovy: number;
        r: number;
        color: string;
        alpha: number;
      };

      let blobs: Blob[] = [];
      let w = 0;
      let h = 0;
      let raf = 0;
      let running = false;

      const pointer = { x: 0, y: 0, tx: 0, ty: 0, active: false };

      const rand = (min: number, max: number) =>
        min + Math.random() * (max - min);

      function pickColor() {
        let roll = Math.random();
        for (let i = 0; i < palette.length; i++) {
          roll -= weights[i]!;
          if (roll <= 0) return palette[i]!;
        }
        return palette[0]!;
      }

      /** Turns `#rrggbb` into `rgba(r, g, b, a)`. */
      function withAlpha(hex: string, alpha: number) {
        const v = hex.replace('#', '');
        const full =
          v.length === 3
            ? v
                .split('')
                .map((c) => c + c)
                .join('')
            : v;
        const n = parseInt(full, 16);
        return `rgba(${(n >> 16) & 255}, ${(n >> 8) & 255}, ${n & 255}, ${alpha})`;
      }

      function build() {
        if (!canvas || !ctx) return;
        const rect = wrap!.getBoundingClientRect();
        const aspect = Math.max(0.2, rect.width) / Math.max(0.2, rect.height);

        if (aspect >= 1) {
          w = CONFIG.bufferSize;
          h = Math.max(8, Math.round(CONFIG.bufferSize / aspect));
        } else {
          h = CONFIG.bufferSize;
          w = Math.max(8, Math.round(CONFIG.bufferSize * aspect));
        }

        canvas.width = w;
        canvas.height = h;

        const short = Math.min(w, h);
        const toRad = Math.PI / 180;

        // Stratified placement: spread the strokes over a jittered grid so they
        // never clump into a single muddy patch.
        const cols = Math.ceil(Math.sqrt(CONFIG.blobCount * (w / h)));
        const rows = Math.ceil(CONFIG.blobCount / cols);

        blobs = Array.from({ length: CONFIG.blobCount }, (_, i) => {
          const col = i % cols;
          const row = Math.floor(i / cols);
          const angle =
            (CONFIG.angleDegrees + rand(-CONFIG.angleSpread, CONFIG.angleSpread)) *
            toRad;
          const speed = rand(0.55, 1) * CONFIG.driftSpeed;
          return {
            x: ((col + rand(0.05, 0.95)) / cols) * w * 1.2 - w * 0.1,
            y: ((row + rand(0.05, 0.95)) / rows) * h * 1.2 - h * 0.1,
            vx: Math.cos(angle) * speed,
            vy: Math.sin(angle) * speed,
            ox: 0,
            oy: 0,
            ovx: 0,
            ovy: 0,
            r: rand(CONFIG.minRadius, CONFIG.maxRadius) * short,
            color: pickColor(),
            alpha: rand(CONFIG.opacityMin, CONFIG.opacityMax),
          };
        });
      }

      function draw() {
        if (!ctx) return;

        ctx.globalCompositeOperation = 'source-over';
        const bg = ctx.createLinearGradient(0, 0, w, h);
        bg.addColorStop(0, baseLight);
        bg.addColorStop(0.55, base);
        bg.addColorStop(1, baseDeep);
        ctx.fillStyle = bg;
        ctx.fillRect(0, 0, w, h);

        const short = Math.min(w, h);
        const cr = CONFIG.cursorRadius * short;
        const cr2 = cr * cr;
        const maxOff = CONFIG.maxDisplacement * short;

        // The field chases the real pointer rather than tracking it. Everything
        // downstream reads this lagged position, so a fast flick of the mouse
        // arrives as a slow swell instead of a jolt.
        pointer.x += (pointer.tx - pointer.x) * CONFIG.pointerEase;
        pointer.y += (pointer.ty - pointer.y) * CONFIG.pointerEase;

        for (const b of blobs) {
          if (!reduced) {
            // Home drifts on regardless; the pointer never touches it.
            b.x += b.vx;
            b.y += b.vy;

            const pad = b.r;
            if (b.x < -pad) b.x = w + pad;
            if (b.x > w + pad) b.x = -pad;
            if (b.y < -pad) b.y = h + pad;
            if (b.y > h + pad) b.y = -pad;

            // A soft radial push away from the pointer, strongest at the centre
            // of its reach and fading to nothing at the edge.
            if (pointer.active) {
              const dx = b.x + b.ox - pointer.x;
              const dy = b.y + b.oy - pointer.y;
              const d2 = dx * dx + dy * dy;
              if (d2 < cr2 && d2 > 0.0001) {
                const d = Math.sqrt(d2);
                const falloff = 1 - d / cr;
                // Cubed, so the push is felt close in and dies away smoothly.
                const push = falloff * falloff * falloff * CONFIG.cursorPush;
                b.ovx += (dx / d) * push * short;
                b.ovy += (dy / d) * push * short;
              }
            }

            // Spring the displacement back toward zero, heavily damped.
            b.ovx = (b.ovx - b.ox * CONFIG.springBack) * CONFIG.damping;
            b.ovy = (b.ovy - b.oy * CONFIG.springBack) * CONFIG.damping;
            b.ox += b.ovx;
            b.oy += b.ovy;

            // Cap how far colour can travel from home.
            const off = Math.hypot(b.ox, b.oy);
            if (off > maxOff) {
              b.ox = (b.ox / off) * maxOff;
              b.oy = (b.oy / off) * maxOff;
            }
          }

          // Elongation follows the blob's own drift, with only a small
          // contribution from displacement — so pushing it around swells the
          // stroke slightly rather than whipping it into a streak.
          const dvx = b.vx + b.ovx * 0.35;
          const dvy = b.vy + b.ovy * 0.35;
          const speed = Math.hypot(dvx, dvy);
          const stretch = Math.min(
            CONFIG.maxElongation,
            CONFIG.elongation + speed * CONFIG.elongationFromSpeed,
          );
          const angle = Math.atan2(dvy, dvx);

          ctx.save();
          ctx.translate(b.x + b.ox, b.y + b.oy);
          ctx.rotate(angle);
          ctx.scale(stretch, 1);

          const g = ctx.createRadialGradient(0, 0, 0, 0, 0, b.r);
          g.addColorStop(0, withAlpha(b.color, b.alpha));
          g.addColorStop(0.45, withAlpha(b.color, b.alpha * 0.72));
          g.addColorStop(1, withAlpha(b.color, 0));
          ctx.fillStyle = g;
          ctx.beginPath();
          ctx.arc(0, 0, b.r, 0, Math.PI * 2);
          ctx.fill();
          ctx.restore();
        }
      }

      function frame() {
        draw();
        raf = requestAnimationFrame(frame);
      }

      function start() {
        if (running || reduced) return;
        running = true;
        raf = requestAnimationFrame(frame);
      }

      function stop() {
        running = false;
        cancelAnimationFrame(raf);
      }

      // Pointer tracking lives on the window, since the canvas is behind text.
      window.addEventListener(
        'pointermove',
        (e) => {
          if (e.pointerType === 'touch') return;
          const rect = wrap!.getBoundingClientRect();
          if (rect.height <= 0) return;
          const nx = ((e.clientX - rect.left) / rect.width) * w;
          const ny = ((e.clientY - rect.top) / rect.height) * h;
          if (!pointer.active) {
            // First sighting: start the lagged position under the cursor rather
            // than sweeping it across the whole field.
            pointer.x = nx;
            pointer.y = ny;
          }
          pointer.tx = nx;
          pointer.ty = ny;
          pointer.active = true;
        },
        { passive: true },
      );

      window.addEventListener('pointerleave', () => {
        pointer.active = false;
      });

      // Pause when scrolled away or when the tab is hidden.
      const io = new IntersectionObserver(
        ([entry]) => {
          if (entry?.isIntersecting && !document.hidden) start();
          else stop();
        },
        { threshold: 0 },
      );
      io.observe(wrap);

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) stop();
        else start();
      });

      let resizeTimer = 0;
      window.addEventListener('resize', () => {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(() => {
          build();
          draw();
        }, 180);
      });

      build();
      draw();
      canvas.setAttribute('data-ready', '');
      start();
    }
  }
</script>
