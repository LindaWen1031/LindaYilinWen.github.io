---
import type { Project } from '../lib/projects';
import { themeLabels } from '../data/site';
import { url } from '../lib/url';

interface Props {
  project: Project;
  /** The first card on a page gets a larger treatment. */
  feature?: boolean;
  index?: number;
}

const { project, feature = false, index } = Astro.props;
const { data } = project;
const href = url(`/work/${project.id}`);
---

<article class:list={['card', feature && 'card--feature']} data-reveal>
  <a class="card__link" href={href}>
    {
      data.cover ? (
        <img
          class="card__media"
          src={url(data.cover)}
          alt={data.coverAlt ?? ''}
          loading={feature ? 'eager' : 'lazy'}
          decoding="async"
        />
      ) : (
        <div class="card__media card__media--empty" aria-hidden="true" />
      )
    }

    <div class="card__body">
      <p class="eyebrow card__meta">
        {index !== undefined && <span>{String(index + 1).padStart(2, '0')}</span>}
        <span>{data.timeframe}</span>
        <span>{data.org}</span>
      </p>

      <h3 class="card__title">{data.title}</h3>
      <p class="card__summary">{data.summary}</p>

      <ul class="card__themes">
        {data.themes.map((t) => <li>{themeLabels[t] ?? t}</li>)}
      </ul>

      <span class="card__cue">Read the case study</span>
    </div>
  </a>
</article>

<style>
  .card {
    border-top: 1px solid var(--rule);
  }

  .card__link {
    display: grid;
    gap: var(--s-4);
    text-decoration: none;
    padding-block: var(--s-5);
    align-items: start;
  }

  @media (min-width: 48rem) {
    .card__link {
      grid-template-columns: 1fr 1fr;
      gap: var(--s-5);
    }

    .card--feature .card__link {
      grid-template-columns: 1fr;
    }
  }

  .card__media {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-lg);
    background: var(--paper-sunk);
    transition:
      transform var(--dur-slow) var(--ease),
      filter var(--dur) var(--ease);
    filter: saturate(0.92);
  }

  .card--feature .card__media {
    aspect-ratio: 16 / 8;
  }

  .card__media--empty {
    background:
      radial-gradient(
        70% 90% at 30% 20%,
        var(--accent-wash) 0%,
        transparent 60%
      ),
      var(--paper-sunk);
  }

  .card__link:hover .card__media {
    transform: scale(1.015);
    filter: saturate(1);
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }

  .card__meta span + span::before {
    content: '·';
    margin-inline-end: var(--s-2);
    color: var(--rule);
  }

  .card__title {
    font-size: var(--step-2);
    line-height: var(--leading-snug);
  }

  .card--feature .card__title {
    font-size: var(--step-3);
  }

  .card__summary {
    color: var(--ink-soft);
    max-width: 52ch;
  }

  .card__themes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1);
    list-style: none;
    padding: 0;
    margin: var(--s-1) 0 0;
  }

  .card__themes li {
    font-size: var(--step--1);
    color: var(--ink-soft);
    background: var(--accent-wash);
    border-radius: 999px;
    padding: 0.2rem 0.7rem;
    line-height: 1.5;
  }

  .card__cue {
    margin-block-start: var(--s-2);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--accent);
  }

  .card__link:hover .card__cue::after {
    transform: translateX(4px);
  }

  .card__cue::after {
    content: '→';
    display: inline-block;
    margin-inline-start: 0.5em;
    transition: transform var(--dur) var(--ease);
  }
</style>
