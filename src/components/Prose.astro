---
/** Typographic styling for Markdown-rendered case study bodies. */
---

<div class="prose">
  <slot />
</div>

<style is:global>
  .prose {
    max-width: var(--measure);
  }

  .prose > * + * {
    margin-block-start: var(--s-3);
  }

  .prose h2 {
    font-size: var(--step-2);
    line-height: var(--leading-snug);
    margin-block-start: var(--s-6);
  }

  .prose h3 {
    font-size: var(--step-1);
    font-family: var(--font-body);
    font-weight: 600;
    letter-spacing: 0;
    margin-block-start: var(--s-5);
  }

  .prose h2 + p,
  .prose h3 + p {
    margin-block-start: var(--s-2);
  }

  .prose p,
  .prose li {
    color: var(--ink-soft);
  }

  .prose ul,
  .prose ol {
    padding-inline-start: 1.3em;
  }

  .prose li + li {
    margin-block-start: var(--s-1);
  }

  .prose li::marker {
    color: var(--accent-soft);
  }

  .prose blockquote {
    border-inline-start: 2px solid var(--accent-soft);
    padding-inline-start: var(--s-3);
    margin-block: var(--s-5);
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink);
    font-variation-settings: 'SOFT' 40, 'WONK' 1;
  }

  .prose blockquote p {
    color: inherit;
  }

  .prose hr {
    border: 0;
    border-top: 1px solid var(--rule);
    margin-block: var(--s-6);
  }

  .prose img {
    width: 100%;
    border-radius: var(--radius-lg);
    margin-block: var(--s-4);
  }

  .prose code {
    font-size: 0.9em;
    background: var(--paper-sunk);
    padding: 0.15em 0.4em;
    border-radius: var(--radius);
  }

  .prose a {
    color: var(--accent);
  }

  /* Tables: visible rules, generous padding, and a slightly smaller type size
     so a data table reads as a table rather than a wall of text.
     NOTE: this <style> block is already `is:global`, so selectors must NOT be
     wrapped in :global() — doing so emits a literal ":global(" into the CSS and
     the browser drops the rule. */
  .prose table {
    width: 100%;
    border-collapse: collapse;
    border: 1px solid var(--ink-faint);
    margin-block: var(--s-5);
    font-size: var(--step--1);
    line-height: 1.5;
  }

  .prose th,
  .prose td {
    padding: var(--s-2) var(--s-3);
    border: 1px solid color-mix(in srgb, var(--ink-faint) 55%, var(--paper));
    text-align: left;
    vertical-align: top;
    color: var(--ink-soft);
  }

  .prose thead th {
    background: var(--paper-sunk);
    border-bottom: 2px solid var(--ink-faint);
    font-weight: 600;
    color: var(--ink);
  }

  .prose tbody tr:nth-child(even) {
    background: var(--paper-raised);
  }

  @media (max-width: 34rem) {
    .prose table {
      display: block;
      overflow-x: auto;
    }
  }
</style>
