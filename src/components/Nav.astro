---
import { site } from '../data/site';
import { url, isCurrent } from '../lib/url';

const pathname = Astro.url.pathname;

const items = [
  { label: 'Work', href: url('/work') },
  { label: 'About', href: url('/about') },
];
---

<header class="nav">
  <div class="nav__inner wrap-wide">
    <a class="nav__brand" href={url('/')}>
      <span class="nav__name">{site.name}</span>
      <span class="nav__role">{site.role}, {site.org}</span>
    </a>

    <nav aria-label="Primary">
      <ul class="nav__list">
        {
          items.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href, pathname) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    /* A fixed height, so pages with a full-bleed hero can pull up under it by
       exactly --nav-height and leave no sliver of background showing. */
    height: var(--nav-height);
    display: flex;
    align-items: center;
    background: color-mix(in srgb, var(--paper) 82%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid transparent;
    transition:
      background var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .nav__inner {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-4);
    width: 100%;
  }

  /*
   * On the home page the nav sits over the coloured hero, so it goes
   * transparent with light type until the reader scrolls past it.
   */
  :global(body[data-over-hero]) .nav {
    background: transparent;
    backdrop-filter: none;
    color: var(--hero-ink);
  }

  :global(body[data-over-hero]) .nav__role {
    color: var(--hero-ink-soft);
  }

  :global(body[data-over-hero]) .nav__list a {
    color: var(--hero-ink-soft);
  }

  :global(body[data-over-hero]) .nav__list a:hover,
  :global(body[data-over-hero]) .nav__list a[aria-current='page'] {
    color: var(--hero-ink);
    border-bottom-color: var(--hero-ink);
  }

  .nav__brand {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    line-height: 1.25;
  }

  .nav__name {
    font-family: var(--font-display);
    font-size: var(--step-0);
    letter-spacing: var(--tracking-tight);
    font-variation-settings: 'SOFT' 40, 'WONK' 1;
  }

  .nav__role {
    font-size: var(--step--1);
    color: var(--ink-faint);
  }

  .nav__list {
    display: flex;
    gap: var(--s-4);
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: var(--step--1);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .nav__list a {
    text-decoration: none;
    color: var(--ink-soft);
    padding-block: 0.25rem;
    border-bottom: 1px solid transparent;
  }

  .nav__list a:hover,
  .nav__list a[aria-current='page'] {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }

  @media (max-width: 30rem) {
    .nav__role {
      display: none;
    }
  }
</style>
