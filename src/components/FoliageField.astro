---
/**
 * FoliageField — the landing-page backdrop.
 *
 * A canopy of monstera leaves you appear to be standing inside. Leaves are
 * generated as real geometry: an ovate blade with deep marginal splits and
 * a few fenestrations, so no image assets are involved and every leaf differs.
 *
 * Depth is what sells it. Two stacked canvases:
 *   · far  — many small, sunlit, lightly blurred leaves sitting back in the
 *            canopy.
 *   · near — a handful of huge, dark, heavily blurred leaves that pass in
 *            front of you, biased toward the edges so they frame the headline
 *            rather than sit behind it.
 *
 * Motion is deliberately slow: each leaf sways on its own phase, and the
 * pointer behaves like a hand pushing through undergrowth — it eases toward
 * where the mouse actually is, softly shoulders nearby leaves aside, twists
 * them as it sweeps past, and everything settles back on a damped spring.
 * Nothing tracks the mouse directly, so quick movements barely register.
 *
 * It is decorative: `aria-hidden`, sits behind real DOM text, and holds a
 * single still frame for anyone who prefers reduced motion.
 *
 * ── TUNING ──────────────────────────────────────────────────────────────────
 * Every dial lives in the CONFIG block at the top of the script below.
 * Colours come from the `--leaf-*` and `--hero-*` custom properties in
 * src/styles/tokens.css.
 */
---

<div class="field" aria-hidden="true">
  <canvas id="foliage-far" class="layer layer--far"></canvas>
  <canvas id="foliage-near" class="layer layer--near"></canvas>
</div>

<style>
  .field {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--hero-base);
  }

  .layer {
    /* Oversized and offset so the blur never reveals a soft edge. The
       `max-width` override matters: the global reset clamps media to 100%,
       which would crop this back and leave a hard edge down the hero. */
    position: absolute;
    top: -8%;
    left: -8%;
    width: 116%;
    height: 116%;
    max-width: none;
    display: block;
    opacity: 0;
    transition: opacity 1600ms var(--ease);
  }

  /* The depth-of-field. Leaves further back are nearly sharp; the ones
     brushing past you are thrown well out of focus. */
  .layer--far {
    filter: blur(3px) saturate(1.06);
  }

  .layer--near {
    filter: blur(16px) saturate(1.04);
  }

  .field[data-ready] .layer {
    opacity: 1;
  }

  /* A soft vignette keeps the headline legible over the brightest leaves. */
  .field::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgba(60, 30, 20, 0.16) 0%,
        rgba(60, 30, 20, 0) 30%,
        rgba(60, 30, 20, 0.26) 100%
      ),
      radial-gradient(
        120% 90% at 50% 45%,
        rgba(60, 30, 20, 0) 42%,
        rgba(60, 30, 20, 0.18) 100%
      );
  }
</style>

<script>
  // ── CONFIG ────────────────────────────────────────────────────────────────
  // Safe to fiddle with. Nothing below this block needs to change.
  const CONFIG = {
    /** ── Pointer feel ──────────────────────────────────────────────────────
     *  How quickly the canopy's idea of "where the pointer is" catches up to
     *  the real one. Low numbers are the whole trick: the leaves lag behind
     *  the mouse instead of snapping to it, so a fast flick barely registers. */
    pointerEase: 0.05,
    /** Reach of the pointer, as a fraction of the buffer's short edge. Kept
     *  local, so it reads as parting the leaves around your hand rather than
     *  the whole canopy lurching. */
    cursorRadius: 0.45,
    /** How hard the pointer shoulders leaves aside, per frame, as a fraction
     *  of the short edge. Tiny — the spring below balances it out at a
     *  displacement of only a few percent. */
    cursorPush: 0.0007,
    /** How much a passing cursor twists a leaf. */
    cursorTwist: 0.00045,
    /** How firmly displaced leaves are pulled back. Low = a long, slow
     *  relaxation. */
    springBack: 0.012,
    /** Damping on that return. High = no visible bounce, just a soft glide. */
    damping: 0.9,
    /** Ceiling on displacement, as a fraction of the buffer's short edge. */
    maxDisplacement: 0.12,
    /** Spring and damping for the twist, kept separate so leaves can rock
     *  back a little more loosely than they slide. */
    twistSpring: 0.02,
    twistDamping: 0.88,

    /** ── Ambient motion ────────────────────────────────────────────────────
     *  Sway is what keeps the canopy alive when nobody is moving the mouse.
     *  Amplitude is in radians; speed is cycles per second. */
    swaySpeed: 0.055,
    /** Very slow positional drift, in buffer pixels per frame. */
    driftSpeed: 0.045,

    /** ── Leaf shape ────────────────────────────────────────────────────────
     *  A monstera reads from four things: a broad ovate blade, a heart-shaped
     *  notch where the stem meets it, a few deep splits cut in from the
     *  margin, and holes near the midrib. Keep the lobe count low — the lobes
     *  are broad paddles, not fern fronds. */
    minLobes: 3,
    maxLobes: 5,
    /** Half-width of the blade at its widest, as a fraction of leaf length. */
    minWidth: 0.42,
    maxWidth: 0.56,
    /** How far the marginal splits cut toward the midrib. 0 = no split,
     *  0.9 = almost severed into separate leaflets. */
    minSplit: 0.4,
    maxSplit: 0.72,
    /** Depth of the heart-shaped notch at the stem end, as a fraction of
     *  leaf length. */
    baseNotch: 0.16,
    /** Chance a given lobe carries a fenestration. */
    holeChance: 0.7,

    /** ── Depth layers ──────────────────────────────────────────────────────
     *  Ordered back to front. `length` is a multiple of the buffer's short
     *  edge, so leaves scale with the viewport. */
    layers: [
      {
        id: 'foliage-far',
        /** Longest edge of the offscreen buffer, in pixels. */
        buffer: 900,
        count: 15,
        minLength: 0.3,
        maxLength: 0.6,
        minAlpha: 0.26,
        maxAlpha: 0.52,
        /** How strongly this layer answers the pointer. Nearer = more. */
        pointerScale: 0.55,
        swayAmount: 0.055,
        /** 0 = leaves anywhere, 1 = pushed hard to the edges of the frame. */
        edgeBias: 0,
        /** This layer paints the base gradient, so it needs no transparency. */
        opaque: true,
        colors: ['--leaf-1', '--leaf-2', '--leaf-3', '--leaf-4'],
        veinColor: '--leaf-vein',
      },
      {
        id: 'foliage-near',
        buffer: 520,
        count: 6,
        minLength: 0.95,
        maxLength: 1.55,
        minAlpha: 0.42,
        maxAlpha: 0.62,
        pointerScale: 1.5,
        swayAmount: 0.1,
        edgeBias: 0.82,
        opaque: false,
        colors: ['--leaf-near-1', '--leaf-near-2'],
        veinColor: '--leaf-near-vein',
      },
    ],
  };
  // ──────────────────────────────────────────────────────────────────────────

  const wrap = document.querySelector<HTMLElement>('.field');

  if (wrap) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const styles = getComputedStyle(document.documentElement);
    const readColor = (name: string, fallback: string) =>
      styles.getPropertyValue(name).trim() || fallback;

    const base = readColor('--hero-base', '#c26550');
    const baseLight = readColor('--hero-base-light', '#d9885f');
    const baseDeep = readColor('--hero-base-deep', '#a34a44');

    const rand = (min: number, max: number) => min + Math.random() * (max - min);
    const pick = <T,>(list: T[]) => list[Math.floor(Math.random() * list.length)]!;

    /** Turns `#rrggbb` into `rgba(r, g, b, a)`. */
    function withAlpha(hex: string, alpha: number) {
      const v = hex.replace('#', '');
      const full =
        v.length === 3
          ? v
              .split('')
              .map((c) => c + c)
              .join('')
          : v;
      const n = parseInt(full, 16);
      return `rgba(${(n >> 16) & 255}, ${(n >> 8) & 255}, ${n & 255}, ${alpha})`;
    }

    // ── Leaf geometry ───────────────────────────────────────────────────────
    // Built once per leaf in normalised units: the midrib runs along +x with
    // the stem end at x = -0.45 and the tip at x = 0.55, so the leaf turns
    // about roughly its own middle. Drawing then costs one transform and one
    // fill, no matter how large it ends up on screen.

    /** Half-width of the blade at position `t` (0 = stem, 1 = tip). Broad
     *  early and tapering to a point, which is what makes it read as a leaf
     *  rather than an ellipse. */
    const profile = (t: number, width: number) =>
      width * Math.pow(Math.sin(Math.PI * Math.pow(t, 0.7)), 0.6);

    function buildLeaf() {
      const lobes = Math.round(rand(CONFIG.minLobes, CONFIG.maxLobes));
      const width = rand(CONFIG.minWidth, CONFIG.maxWidth);
      const inner = 1 - rand(CONFIG.minSplit, CONFIG.maxSplit);
      const ox = -0.45;
      // The blade starts a little way along the midrib, leaving room for the
      // heart-shaped notch at the stem end.
      const t0Base = 0.07;

      // Where along the midrib each split falls, jittered so the lobes are
      // not mechanically even.
      const cuts: number[] = [t0Base];
      for (let i = 1; i < lobes; i++) {
        cuts.push(t0Base + (1 - t0Base) * ((i + rand(-0.18, 0.18)) / lobes));
      }
      cuts.push(1);

      const blade = new Path2D();
      const veins = new Path2D();
      const w = (t: number) => profile(t, width);

      // Upper margin, stem to tip: each lobe bulges out and is separated from
      // the next by a notch cut back toward the midrib.
      blade.moveTo(ox + t0Base, -w(t0Base));
      for (let i = 0; i < lobes; i++) {
        const t0 = cuts[i]!;
        const t1 = cuts[i + 1]!;
        const tm = t0 + (t1 - t0) * 0.55;
        const peak = w(tm);
        blade.quadraticCurveTo(
          ox + t0 + (tm - t0) * 0.35,
          -peak * 1.02,
          ox + tm,
          -peak,
        );
        blade.quadraticCurveTo(
          ox + tm + (t1 - tm) * 0.62,
          -peak * 0.96,
          ox + t1,
          -w(t1) * inner,
        );
        veins.moveTo(ox + t0 + (tm - t0) * 0.1, 0);
        veins.lineTo(ox + tm, -peak * 0.82);
      }

      // Lower margin, tip back to stem.
      for (let i = lobes - 1; i >= 0; i--) {
        const t0 = cuts[i]!;
        const t1 = cuts[i + 1]!;
        const tm = t0 + (t1 - t0) * 0.55;
        const peak = w(tm);
        blade.quadraticCurveTo(
          ox + tm + (t1 - tm) * 0.62,
          peak * 0.96,
          ox + tm,
          peak,
        );
        blade.quadraticCurveTo(
          ox + t0 + (tm - t0) * 0.35,
          peak * 1.02,
          ox + t0,
          w(t0) * inner,
        );
        veins.moveTo(ox + t0 + (tm - t0) * 0.1, 0);
        veins.lineTo(ox + tm, peak * 0.82);
      }

      // The heart-shaped notch at the stem end: two rounded basal lobes with
      // a V cut between them, where the petiole would attach.
      blade.quadraticCurveTo(ox, w(t0Base) * 0.9, ox + CONFIG.baseNotch, 0);
      blade.quadraticCurveTo(ox, -w(t0Base) * 0.9, ox + t0Base, -w(t0Base));
      blade.closePath();

      // Fenestrations. Added as separate subpaths and filled even-odd, so they
      // punch genuine holes rather than painting over what is behind.
      for (let i = 1; i < lobes - 1; i++) {
        if (Math.random() > CONFIG.holeChance) continue;
        const t0 = cuts[i]!;
        const t1 = cuts[i + 1]!;
        const tm = t0 + (t1 - t0) * 0.55;
        const peak = w(tm);
        const rx = (t1 - t0) * rand(0.2, 0.3);
        const ry = peak * rand(0.12, 0.2);
        const cy = peak * rand(0.3, 0.5) * (Math.random() < 0.5 ? -1 : 1);
        blade.moveTo(ox + tm + rx, cy);
        blade.ellipse(ox + tm, cy, rx, ry, 0, 0, Math.PI * 2);
      }

      // The midrib itself, drawn last so it sits over the veins.
      veins.moveTo(ox + CONFIG.baseNotch, 0);
      veins.lineTo(ox + 0.98, 0);

      return { blade, veins };
    }

    // ── Layers ──────────────────────────────────────────────────────────────

    type Leaf = {
      x: number;
      y: number;
      vx: number;
      vy: number;
      /** Displacement from home, and how fast it is changing. The pointer
       *  moves only this, never the leaf's home position. */
      ox: number;
      oy: number;
      ovx: number;
      ovy: number;
      rot: number;
      twist: number;
      twistV: number;
      phase: number;
      len: number;
      blade: Path2D;
      veins: Path2D;
      fill: string;
      vein: string;
    };

    type Layer = {
      canvas: HTMLCanvasElement;
      ctx: CanvasRenderingContext2D;
      spec: (typeof CONFIG.layers)[number];
      w: number;
      h: number;
      leaves: Leaf[];
    };

    const layers: Layer[] = [];

    for (const spec of CONFIG.layers) {
      const canvas = document.getElementById(spec.id) as HTMLCanvasElement | null;
      if (!canvas) continue;
      const ctx = canvas.getContext('2d', { alpha: !spec.opaque });
      if (!ctx) continue;
      layers.push({ canvas, ctx, spec, w: 0, h: 0, leaves: [] });
    }

    if (layers.length) {
      // Pointer is tracked in normalised 0–1 coordinates, since each layer has
      // its own buffer size. `x`/`y` is the lagged position everything reads;
      // `tx`/`ty` is where the mouse actually is.
      const pointer = { x: 0.5, y: 0.5, tx: 0.5, ty: 0.5, px: 0.5, py: 0.5, active: false };

      let raf = 0;
      let running = false;

      function buildLayer(layer: Layer) {
        const rect = wrap!.getBoundingClientRect();
        const aspect = Math.max(0.2, rect.width) / Math.max(0.2, rect.height);
        const { spec } = layer;

        if (aspect >= 1) {
          layer.w = spec.buffer;
          layer.h = Math.max(8, Math.round(spec.buffer / aspect));
        } else {
          layer.h = spec.buffer;
          layer.w = Math.max(8, Math.round(spec.buffer * aspect));
        }

        layer.canvas.width = layer.w;
        layer.canvas.height = layer.h;

        const short = Math.min(layer.w, layer.h);
        const palette = spec.colors.map((name) => readColor(name, '#c98a63'));
        const vein = readColor(spec.veinColor, '#ffffff');

        layer.leaves = Array.from({ length: spec.count }, () => {
          const { blade, veins } = buildLeaf();
          const drift = rand(0.5, 1) * CONFIG.driftSpeed;
          const dir = rand(0, Math.PI * 2);

          // Edge-biased layers keep their leaves out toward the frame, so the
          // headline sits in a clearing rather than behind a leaf.
          let fx = Math.random();
          let fy = Math.random();
          if (spec.edgeBias > 0) {
            const pushOut = (f: number) =>
              f < 0.5
                ? f * (1 - spec.edgeBias)
                : 1 - (1 - f) * (1 - spec.edgeBias);
            if (Math.random() < 0.5) fx = pushOut(fx);
            else fy = pushOut(fy);
          }

          return {
            x: fx * layer.w * 1.3 - layer.w * 0.15,
            y: fy * layer.h * 1.3 - layer.h * 0.15,
            vx: Math.cos(dir) * drift,
            vy: Math.sin(dir) * drift,
            ox: 0,
            oy: 0,
            ovx: 0,
            ovy: 0,
            rot: rand(0, Math.PI * 2),
            twist: 0,
            twistV: 0,
            phase: rand(0, Math.PI * 2),
            len: rand(spec.minLength, spec.maxLength) * short,
            blade,
            veins,
            fill: withAlpha(pick(palette), rand(spec.minAlpha, spec.maxAlpha)),
            vein: withAlpha(vein, rand(0.1, 0.24)),
          };
        });
      }

      function drawLayer(layer: Layer, time: number) {
        const { ctx, spec, w, h } = layer;

        if (spec.opaque) {
          const bg = ctx.createLinearGradient(0, 0, w, h);
          bg.addColorStop(0, baseLight);
          bg.addColorStop(0.55, base);
          bg.addColorStop(1, baseDeep);
          ctx.fillStyle = bg;
          ctx.fillRect(0, 0, w, h);
        } else {
          ctx.clearRect(0, 0, w, h);
        }

        const short = Math.min(w, h);
        const cr = CONFIG.cursorRadius * short;
        const cr2 = cr * cr;
        const maxOff = CONFIG.maxDisplacement * short;
        const push = CONFIG.cursorPush * short * spec.pointerScale;
        const twistForce = CONFIG.cursorTwist * spec.pointerScale;

        // The lagged pointer, and its own smoothed velocity, in this layer's
        // buffer pixels.
        const pxNow = pointer.x * w;
        const pyNow = pointer.y * h;
        const pvx = (pointer.x - pointer.px) * w;
        const pvy = (pointer.y - pointer.py) * h;

        for (const leaf of layer.leaves) {
          if (!reduced) {
            // Home drifts on regardless; the pointer never touches it.
            leaf.x += leaf.vx;
            leaf.y += leaf.vy;

            const pad = leaf.len;
            if (leaf.x < -pad) leaf.x = w + pad;
            if (leaf.x > w + pad) leaf.x = -pad;
            if (leaf.y < -pad) leaf.y = h + pad;
            if (leaf.y > h + pad) leaf.y = -pad;

            if (pointer.active) {
              const dx = leaf.x + leaf.ox - pxNow;
              const dy = leaf.y + leaf.oy - pyNow;
              const d2 = dx * dx + dy * dy;
              if (d2 < cr2 && d2 > 0.0001) {
                const d = Math.sqrt(d2);
                const falloff = 1 - d / cr;
                // Cubed, so the push is felt close in and dies away smoothly.
                const strength = falloff * falloff * falloff;
                leaf.ovx += (dx / d) * strength * push;
                leaf.ovy += (dy / d) * strength * push;
                // A cursor sweeping past a leaf rotates it, the way a hand
                // turns a leaf it brushes rather than just shoving it.
                const cross = (dx / d) * pvy - (dy / d) * pvx;
                leaf.twistV += cross * strength * twistForce;
              }
            }

            // Spring displacement and twist back to rest, heavily damped.
            leaf.ovx = (leaf.ovx - leaf.ox * CONFIG.springBack) * CONFIG.damping;
            leaf.ovy = (leaf.ovy - leaf.oy * CONFIG.springBack) * CONFIG.damping;
            leaf.ox += leaf.ovx;
            leaf.oy += leaf.ovy;

            const off = Math.hypot(leaf.ox, leaf.oy);
            if (off > maxOff) {
              leaf.ox = (leaf.ox / off) * maxOff;
              leaf.oy = (leaf.oy / off) * maxOff;
            }

            leaf.twistV =
              (leaf.twistV - leaf.twist * CONFIG.twistSpring) *
              CONFIG.twistDamping;
            leaf.twist += leaf.twistV;
          }

          const sway =
            Math.sin(time * CONFIG.swaySpeed * Math.PI * 2 + leaf.phase) *
            spec.swayAmount;

          ctx.save();
          ctx.translate(leaf.x + leaf.ox, leaf.y + leaf.oy);
          ctx.rotate(leaf.rot + sway + leaf.twist);
          ctx.scale(leaf.len, leaf.len);
          ctx.fillStyle = leaf.fill;
          ctx.fill(leaf.blade, 'evenodd');
          ctx.strokeStyle = leaf.vein;
          ctx.lineWidth = 0.007;
          ctx.stroke(leaf.veins);
          ctx.restore();
        }
      }

      function draw() {
        const time = performance.now() * 0.001;
        // Ease toward the real pointer rather than tracking it, so a fast
        // flick of the mouse arrives as a slow swell instead of a jolt.
        pointer.px = pointer.x;
        pointer.py = pointer.y;
        pointer.x += (pointer.tx - pointer.x) * CONFIG.pointerEase;
        pointer.y += (pointer.ty - pointer.y) * CONFIG.pointerEase;

        for (const layer of layers) drawLayer(layer, time);
      }

      function frame() {
        draw();
        raf = requestAnimationFrame(frame);
      }

      function start() {
        if (running || reduced) return;
        running = true;
        raf = requestAnimationFrame(frame);
      }

      function stop() {
        running = false;
        cancelAnimationFrame(raf);
      }

      // Pointer tracking lives on the window, since the canvases sit behind text.
      window.addEventListener(
        'pointermove',
        (e) => {
          if (e.pointerType === 'touch') return;
          const rect = wrap!.getBoundingClientRect();
          if (rect.height <= 0 || rect.width <= 0) return;
          const nx = (e.clientX - rect.left) / rect.width;
          const ny = (e.clientY - rect.top) / rect.height;
          if (!pointer.active) {
            // First sighting: start the lagged position under the cursor
            // rather than sweeping it across the whole canopy.
            pointer.x = nx;
            pointer.y = ny;
            pointer.px = nx;
            pointer.py = ny;
          }
          pointer.tx = nx;
          pointer.ty = ny;
          pointer.active = true;
        },
        { passive: true },
      );

      window.addEventListener('pointerleave', () => {
        pointer.active = false;
      });

      // Pause when scrolled away or when the tab is hidden.
      const io = new IntersectionObserver(
        ([entry]) => {
          if (entry?.isIntersecting && !document.hidden) start();
          else stop();
        },
        { threshold: 0 },
      );
      io.observe(wrap);

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) stop();
        else start();
      });

      let resizeTimer = 0;
      window.addEventListener('resize', () => {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(() => {
          for (const layer of layers) buildLayer(layer);
          draw();
        }, 180);
      });

      for (const layer of layers) buildLayer(layer);
      draw();
      wrap.setAttribute('data-ready', '');
      start();
    }
  }
</script>
