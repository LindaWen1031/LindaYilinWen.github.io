---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/figtree';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  /** Absolute or site-relative path to a social preview image. */
  image?: string;
  /** Set on the home page so the nav sits over the hero. */
  transparentNav?: boolean;
}

const {
  title,
  description = site.description,
  image,
  transparentNav = false,
} = Astro.props;

const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const ogImage = image
  ? new URL(image.startsWith('http') ? image : url(image), canonical).toString()
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.toString()} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#faf7f2" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.toString()} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta
      name="twitter:card"
      content={ogImage ? 'summary_large_image' : 'summary'}
    />

    <slot name="head" />
  </head>

  <body data-transparent-nav={transparentNav ? '' : undefined}>
    <script is:inline>
      // Marks the document as JS-capable. The scroll-reveal styles only hide
      // content when this class is present, so a script failure can never leave
      // the page blank.
      document.documentElement.classList.add('js');
    </script>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Quiet fade-and-rise as sections come into view. Purely additive: if
      // JavaScript never runs, everything is already visible.
      const reduced = window.matchMedia(
        '(prefers-reduced-motion: reduce)',
      ).matches;
      const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');

      if (reduced || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.setAttribute('data-revealed', ''));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.setAttribute('data-revealed', '');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.05 },
        );
        targets.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>

<style is:global>
  .js [data-reveal] {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity var(--dur-slow) var(--ease),
      transform var(--dur-slow) var(--ease);
  }

  .js [data-reveal][data-revealed] {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .js [data-reveal] {
      opacity: 1;
      transform: none;
    }
  }
</style>
